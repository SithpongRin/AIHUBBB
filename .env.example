# AIHUB Environment Configuration
# Copy this file to .env.local for local development.

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional server-side Supabase Service Role key (for admin endpoints, NEVER prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# NOTE: AIHUB uses a Bring Your Own Key (BYOK) architecture.
# Users supply their own OpenAI, Gemini, and Claude API keys in the AIHUB settings.
# API keys are stored in browser memory/session and sent per-request to API functions.
# Never hardcode AI API keys or secrets in this file.
